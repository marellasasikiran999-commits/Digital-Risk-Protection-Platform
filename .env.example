# Digital Risk Protection Platform - Environment Configuration Template
# Duplicate this file to .env and provide your production secrets.

# Backend Configuration
PORT=8000
HOST=localhost
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://digital-risk-protection-platform.vercel.app
RATE_LIMIT_REQUESTS=180
RATE_LIMIT_WINDOW_SECONDS=60

# Security & Authentication Secrets
ADMIN_API_KEY=your_secure_random_admin_api_key_here
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Frontend Client Secrets (Vite prefix required)
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
